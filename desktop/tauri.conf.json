{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Desk",
  "version": "0.1.0",
  "identifier": "app.agent-desk.desktop",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "externalBin": ["binaries/agent-desk"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
